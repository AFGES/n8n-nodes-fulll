{
	"name": "@afges/n8n-nodes-fulll",
	"version": "0.0.3",
	"description": "A collection of n8n nodes for the Fulll API",
	"license": "MIT",
	"homepage": "https://github.com/AFGES/n8n-nodes-fulll#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Charles LESECQ",
		"email": "charles.lesecq@afges.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AFGES/n8n-nodes-fulll.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FulllApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Fulll/Fulll.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
